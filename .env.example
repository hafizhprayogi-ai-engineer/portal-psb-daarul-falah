APP_ENV=development
SECRET_KEY=
BASE_URL=http://127.0.0.1:5000
DATA_DIR=instance
# Kosong = SQLite. Simpan kredensial hanya di .env lokal.
# DATABASE_URL=mysql://USER:PASSWORD_URL_ENCODED@127.0.0.1:3306/psb_daarulfalah
DATABASE_URL=
# ID spreadsheet tujuan (bagian antara /d/ dan /edit). Login lokal via scripts/google_sheets.py.
GOOGLE_SHEETS_ID=
# Aktif setelah operator menjalankan scripts/google_drive.py login dan memberi izin.
GOOGLE_DRIVE_ENABLED=false
COOKIE_SECURE=false
TRUST_PROXY=false
NOTIFICATION_MODE=simulation
# Pengiriman Gmail langsung. Tetap simulation sampai seluruh nilai SMTP diisi.
# Buat App Password Google 16 karakter; jangan simpan kata sandi Gmail biasa.
EMAIL_DELIVERY_MODE=simulation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
INTEGRATION_TOKEN=
PORT=5000
# Alamat tambahan dapat dipisahkan dengan spasi untuk uji Wi-Fi lokal.
# Gunakan LISTEN=auto dan BASE_URL=auto untuk mendeteksi IP saat mulai.
# Contoh: 127.0.0.1:5000 192.168.1.57:5000
LISTEN=
